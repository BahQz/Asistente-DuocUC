# --- Modelo de lenguaje ---
# Proveedor activo: Groq (GPT-OSS 120B). Free tier aproximado: 1.000 solicitudes/día.
# Genera una clave en https://console.groq.com/keys
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_MODEL_SMALL=openai/gpt-oss-120b
LLM_TEMPERATURA=0.2
LLM_MAX_TOKENS=3000
LLM_TIMEOUT=90

# Nivel de razonamiento: solo lo usa la integración nativa de Gemini.
LLM_THINKING_LEVEL=low
# Esfuerzo de razonamiento de GPT-OSS en Groq (low reduce latencia y tokens).
LLM_REASONING_EFFORT=low

# --- Alternativa: Google Gemini 3.5 Flash (integración nativa) ---
# Ojo: el free tier de Gemini puede limitar a 20 solicitudes/día.
# Comenta las líneas de Groq y descomenta estas tres.
#LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#LLM_MODEL=gemini-3.5-flash
#LLM_MODEL_SMALL=gemini-3.5-flash-lite

# --- Alternativa: OpenRouter (modelo gratuito) ---
# Ajusta el modelo según https://openrouter.ai/models?max_price=0
#LLM_BASE_URL=https://openrouter.ai/api/v1
#LLM_MODEL=pon-aqui-el-modelo-free
#LLM_MODEL_SMALL=pon-aqui-el-modelo-free

# --- Memoria conversacional (corto plazo) ---
MEMORIA_MAX_TURNOS=8
MEMORIA_RUTA=.historial/sesion.json

# --- Memoria de largo plazo: ChromaDB + embeddings ---
VECTOR_DIR=.chroma
COLECCION_REGLAMENTOS=reglamentos_duoc
EMBEDDINGS_MODEL=intfloat/multilingual-e5-small
EMBEDDINGS_DISPOSITIVO=cpu
FRAGMENTOS_POR_DEFECTO=3
FRAGMENTOS_MAXIMOS=8
UMBRAL_RELEVANCIA=0.82
MARGEN_RELEVANCIA=0.02

# --- API pública de feriados ---
FERIADOS_URL=https://date.nager.at/api/v3/PublicHolidays
FERIADOS_TIMEOUT=15

# --- Agente ---
AGENTE_MAX_ITERACIONES=18
AGENTE_REINTENTOS=2
AGENTE_DEBUG=0

# --- Documentos generados (opcional) ---
# DOCUMENTOS_DIR=documentos

# --- Observabilidad (EP3) ---
OBS_ACTIVA=1
OBS_DIR=logs
OBS_TRUNCAR_CHARS=300
OBS_ZONA_GRIS=0.03
GUARDRAIL_PII=1
GUARDRAIL_INYECCION=bloquear        # bloquear | alertar | off
GUARDRAIL_RESPALDO=bloquear_grave   # alertar | bloquear_grave | off
BENCH_PRESUPUESTO_TOKENS=150000
BENCH_MAX_TURNOS_LLM=15
BENCH_PAUSA_SEG=2
BENCH_TOKENS_POR_TURNO_ESTIMADO=8000

